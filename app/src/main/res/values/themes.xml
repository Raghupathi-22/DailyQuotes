<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DailyMotivator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialButtonStyle">@style/Widget.DailyQuotes.Button</item>
    </style>
    <style name="Widget.DailyQuotes.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">20dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="Widget.DailyQuotes.IconButton" parent="Widget.MaterialComponents.Button.Icon">
        <item name="cornerRadius">24dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
