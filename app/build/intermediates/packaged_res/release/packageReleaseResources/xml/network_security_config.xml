<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system certificate authorities only. No cleartext, no user/custom trust anchors. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
